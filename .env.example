# Shows Agenda API
SHOWS_API_URL=https://your-agenda-api.com
SHOWS_API_KEY=your-bearer-token

# Neon (managed Postgres)
DATABASE_URI=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# Netcup S3-compatible storage
S3_ENDPOINT=https://your-s3-endpoint.netcup.net
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=show-uploader
S3_REGION=us-east-1

# Redis (overridden to redis://redis:6379 in Docker Compose)
REDIS_URL=redis://localhost:6379

# Groq AI
GROQ_API_KEY=your-groq-api-key

# YouTube OAuth2
# 1. Go to https://console.cloud.google.com
# 2. Enable YouTube Data API v3
# 3. Create OAuth2 credentials (Desktop app)
# 4. Run the OAuth2 flow to get a refresh token
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REFRESH_TOKEN=your-refresh-token

# MixCloud
# 1. Create an app at https://www.mixcloud.com/developers/
# 2. Perform the OAuth2 flow to get an access token
MIXCLOUD_ACCESS_TOKEN=your-access-token

# Archive quality (ffmpeg bitrate strings)
ARCHIVE_VIDEO_BITRATE=4000k
ARCHIVE_AUDIO_BITRATE=256k

# Jingle S3 key (optional — leave empty to disable)
JINGLE_S3_KEY=

# App
PORT=3000
NODE_ENV=production
