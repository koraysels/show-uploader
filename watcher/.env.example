# Folder to watch on this Windows machine
WATCH_FOLDER=C:\Users\you\obs-drop

# Netcup S3 (same credentials as the cloud stack)
S3_ENDPOINT=https://your-s3-endpoint.netcup.net
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=show-uploader
S3_REGION=us-east-1

# Your cloud deployment
API_URL=https://your-show-uploader.example.com
API_KEY=your-api-key
